# SONIC founder-only preview. DO NOT paste credentials into chat or git.
SONIC_ENV=local
SONIC_ENABLE_SOFTWARE_DISCOVERY=false
SONIC_ENABLE_SOFTWARE_INSTALL=false
SONIC_PUBLIC_URL=http://127.0.0.1:8080
SONIC_OWNER_TOKEN_SHA256=
SONIC_SESSION_SECRET=
# OpenAI Responses API (server-side only)
OPENAI_API_KEY=
SONIC_MODEL=gpt-4.1-mini
# Chat/Brain provider defaults. An existing owner choice in Model Router takes precedence.
SONIC_BRAIN_PROVIDER=openai
# Optional native DeepSeek chat; enter the real key only in server secrets.
# This integration uses the fixed official endpoint and explicit non-thinking mode.
DEEPSEEK_API_KEY=
SONIC_DEEPSEEK_MODEL=deepseek-flash
# Optional OpenRouter chat (uses its own API key).
OPENROUTER_API_KEY=
SONIC_OPENROUTER_MODEL=z-ai/glm-5.3-prime
# For Railway, set a durable Postgres URL (SQLite is LOCAL ONLY)
DATABASE_URL=
# Optional local Windows companion (separate token; restricted system.status)
SONIC_DEVICE_ID=TRADEVICEPC
SONIC_DEVICE_TOKEN_SHA256=
# Optional V0.4 Realtime; actual sessions require owner consent and model access.
SONIC_REALTIME_ENABLED=false
SONIC_REALTIME_MODEL=gpt-realtime
SONIC_VOICE_MAX_SECONDS=300
SONIC_VOICE_DAILY_SESSIONS=12
